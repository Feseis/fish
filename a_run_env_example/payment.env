# 复制到 a_run_env/payment.env 后填写真实值；该文件不入库
PAYMENT_DB_URL=jdbc:mysql://localhost:3306/fish_payment?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
PAYMENT_DB_USERNAME=your_username
PAYMENT_DB_PASSWORD=your_password

# 支付宝沙箱：enabled=false 时 payChannel=2 直接返回「未接入」
ALIPAY_ENABLED=false
ALIPAY_APP_ID=your_sandbox_app_id
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 应用私钥（PKCS8，RSA2）与支付宝公钥，两者不能混用
ALIPAY_PRIVATE_KEY=your_app_private_key_pkcs8
ALIPAY_PUBLIC_KEY=your_alipay_public_key
# 留空 = 不下发 notify_url，只走主动查单
ALIPAY_NOTIFY_URL=
