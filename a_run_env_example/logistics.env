# 复制到 a_run_env/logistics.env 后填写真实值；该文件不入库
LOGISTICS_DB_URL=jdbc:mysql://localhost:3306/fish_logistics?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
LOGISTICS_DB_USERNAME=your_username
LOGISTICS_DB_PASSWORD=your_password
REDIS_HOST=localhost
REDIS_PORT=6379
AMAP_WEB_KEY=your_web_service_key
AUTH_SERVICE_URL=http://localhost:8081
